{
  "manifest_version": 3,
  "name": "TX JS工具箱",
  "version": "1.0.0",
  "description": "TX JS工具箱 - 程序员常用开发工具集：JSON、哈希、Base64、加解密、时间戳、JWT、正则等。A collection of essential dev tools.",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "TX JS工具箱",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "id": "tx-sniffer-main",
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-scripts/sniffer-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "id": "tx-sniffer-bridge",
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-scripts/sniffer-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
